# copia esse arquivo pra ".env" e ajusta os valores. o .env real nunca vai pro git.

# gera uma chave nova com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta-gerada

# True so em dev. em producao tem que ser False
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1

# dados do postgres 17 (pode subir um container local, ver docs/backend_e_banco_de_dados.md)
DB_NAME=alocacao_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
